# 禁止通过网址直接访问 storage/（数据库、密钥、日志）
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

<FilesMatch "\.(db|sqlite|sqlite3|db-wal|db-shm|db-journal|key|lock|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
